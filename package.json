{
  "name": "dj-metatagger",
  "version": "1.0.0",
  "description": "BEATWAVE PRO - Precision Audio Intelligence",
  "private": true,
  "scripts": {
    "build": "python3 scripts/build_offline.py",
    "build:js": "python3 scripts/build_offline.py --skip-vendor --skip-fonts --skip-css",
    "build:css": "python3 scripts/build_offline.py --skip-vendor --skip-fonts --skip-js",
    "build:vendor": "python3 scripts/build_offline.py --skip-fonts --skip-css --skip-js",
    "dev": "python3 main_web.py"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "fsevents@2.3.3": true
  }
}
